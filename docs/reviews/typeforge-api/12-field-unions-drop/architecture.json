  "cards": [
    {
      "dot": "emerald",
      "title": "User outcome",
      "items": [
        "int | str \u2192 bare int: Drop removes the whole field; Is[int] keeps it.",
        "int: bytes, str: float produces bytes | float in both consumers."
      ]
    },
    {
      "dot": "amber",
      "title": "Review the guarantees",
      "items": [
        "Evaluate every member and capture output; Drop cannot hide failures.",
        "Flags survive; runtime metadata stays native. Speculative Drop is an error."
      ]
    },
    {
      "dot": "violet",
      "title": "Next on the stack",
