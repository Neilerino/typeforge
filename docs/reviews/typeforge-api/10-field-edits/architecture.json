  "cards": [
    {
      "dot": "cyan",
      "title": "Author outcome",
      "items": [
        "Field(name=..., type=...) creates explicit data; required=True, readonly=False.",
        "field.replace(type=bytes) keeps its original name and flags."
      ]
    },
    {
      "dot": "emerald",
      "title": "Review the invariants",
      "items": [
        "Replacing type replaces metadata; wrapping field.type preserves metadata at the nested position.",
        "Only replacement type consumes Drop; invalid names, flags and collisions fail."
      ]
    },
    {
      "dot": "violet",
      "title": "Existing owners and next slices",
      "items": [
        "Both frontends share evaluation and existing TypedDict family adapters.",
        "11: local aliases. 12: union field edits and Drop. 13: correlated record unions."
      ]
    }
