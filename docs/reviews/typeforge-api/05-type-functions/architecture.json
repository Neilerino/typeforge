  "cards": [
    {
      "dot": "cyan",
      "title": "User contract",
      "items": [
        "Normal Python import constructs an immutable template once.",
        "Selected[int] specializes to str; an unresolved Selected[T] has str | bytes as its output bound.",
        "Schema evaluates the template at runtime."
      ]
    },
    {
      "dot": "emerald",
      "title": "Two frontends, one evaluator",
      "items": [
        "Runtime can build a valid template with ordinary Python code.",
        "Compiler reads supported syntax and never executes the application.",
        "Parameter identities, cycles, and alias binding keep their existing owners."
      ]
    },
    {
      "dot": "amber",
      "title": "Review boundary",
      "items": [
        "Basic source scope: one final return, optional docstring, no value arguments.",
        "Extra compiler body forms land with captures, records, and local aliases.",
        "33 contracts include lifecycle, metadata, isolation, and three checkers."
      ]
    }
  ]
