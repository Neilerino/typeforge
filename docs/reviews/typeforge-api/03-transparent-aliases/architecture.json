  "cards": [
    {
      "dot": "emerald",
      "title": "Review alias transparency",
      "items": [
        "Ordinary aliases select as their expanded types, including nested generic arguments and Is targets.",
        "Explicit Any | str survives nested Maps; Is[Any] remains a different comparison."
      ]
    },
    {
      "dot": "cyan",
      "title": "Review preservation boundaries",
      "items": [
        "Selected output aliases keep Pydantic metadata, references, and recursive validation.",
        "Selection cycles fail at the alias boundary; finite repeated alias applications remain valid."
      ]
    },
    {
      "dot": "amber",
      "title": "Review the next extension",
      "items": [
        "Both frontends keep the shared evaluator. Compiler never executes the application.",
        "Tickets 04–08 extend compatibility and capture bindings; they do not require a parallel old API."
      ]
    }
  ]
